# Copy this file to .env and replace secrets/private deployment values.

SHARELATEX_IMAGE=sharelatex/sharelatex:dev
SHARELATEX_CONTAINER_NAME=sharelatex
SHARELATEX_RESTART_POLICY=always
SHARELATEX_STOP_GRACE_PERIOD=60s
OVERLEAF_HTTP_PORT=80

MONGO_IMAGE=mongo:8.0
MONGO_CONTAINER_NAME=mongo
MONGO_RESTART_POLICY=always
MONGO_REPLICA_SET=overleaf
MONGO_DATABASE=sharelatex

REDIS_IMAGE=redis:6.2
REDIS_CONTAINER_NAME=redis
REDIS_RESTART_POLICY=always

BACKUP_MANAGER_ENABLED=true
BACKUP_MANAGER_IMAGE=overleaf-backup-manager:dev
BACKUP_MANAGER_CONTAINER_NAME=overleaf-backup-manager
BACKUP_RESTORE_CONTAINER_NAME=overleaf-backup-restore
BACKUP_MANAGER_RESTART_POLICY=unless-stopped
BACKUP_DATA_PATH=/opt/overleaf/backups
BACKUP_CPU_LIMIT=1.0
BACKUP_MEMORY_LIMIT=1g
BACKUP_WEB_UID=33
BACKUP_WEB_GID=33
BACKUP_REDIS_UID=999
BACKUP_REDIS_GID=999
BACKUP_MIN_FREE_GB=10
BACKUP_QUIESCE_SECONDS=20
# Generate and store separately from the backup: openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-strong-backup-passphrase

GIT_INTEGRATION_ENABLED=true
# Generate with: openssl rand -base64 32
GIT_INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
GITHUB_SYNC_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_SYNC_CLIENT_SECRET=replace-with-github-oauth-client-secret

CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARED_CONTAINER_NAME=cloudflared-overleaf
CLOUDFLARED_RESTART_POLICY=unless-stopped
CLOUDFLARE_TUNNEL_TOKEN=replace-me

SHARELATEX_DATA_PATH=/opt/overleaf/sharelatex_data
MONGO_DATA_PATH=/opt/overleaf/mongodb/mongo_data
REDIS_DATA_PATH=/opt/overleaf/redis/redis_data
OVERLEAF_NETWORK_NAME=overleaf-net

TZ=Asia/Ho_Chi_Minh
DEBUG_NODE=false
OVERLEAF_APP_NAME=Overleaf Community Edition
OVERLEAF_MONGO_URL=mongodb://mongo:27017/sharelatex?replicaSet=overleaf
OVERLEAF_REDIS_HOST=redis
REDIS_HOST=redis
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
ENABLE_PANDOC_CONVERSIONS=true
LOCAL_PANDOC_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true
VIRTUAL_HOST=overleaf.example.com
OVERLEAF_SITE_URL=https://overleaf.example.com
OVERLEAF_NAV_TITLE=Overleaf Community Edition
OVERLEAF_ADMIN_EMAIL=admin@example.com
OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
ENABLE_CRON_RESOURCE_DELETION=true
OVERLEAF_BEHIND_PROXY=true
OVERLEAF_SECURE_COOKIE=true

OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
OVERLEAF_EMAIL_SMTP_PORT=587
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_USER=overleaf@example.com
OVERLEAF_EMAIL_SMTP_PASS=replace-me
OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
OVERLEAF_EMAIL_SMTP_LOGGER=false
OVERLEAF_CUSTOM_EMAIL_FOOTER=Hosted by your organization
