#!/usr/bin/env bash
set -euo pipefail

BACKUP_ROOT="${BACKUP_ROOT:-/backups}"
CONFIG="$BACKUP_ROOT/schedule.json"
STATE="$BACKUP_ROOT/.scheduler-state"
REQUESTS="$BACKUP_ROOT/.requests"
STATUS="$BACKUP_ROOT/last-run.json"
RUN_LOG="$BACKUP_ROOT/current-run.log"
HEARTBEAT="$BACKUP_ROOT/.scheduler-heartbeat"
WEB_GID="${BACKUP_WEB_GID:-33}"
mkdir -p "$REQUESTS"

write_shared_json() {
  local target="$1"
  local temporary="${target}.$$"
  cat >"$temporary"
  chown "root:$WEB_GID" "$temporary"
  chmod 660 "$temporary"
  mv -f "$temporary" "$target"
}

write_heartbeat() {
  touch "$HEARTBEAT"
  chown "root:$WEB_GID" "$HEARTBEAT"
  chmod 640 "$HEARTBEAT"
}

due_now() {
  local frequency hour minute weekday now_hour now_minute now_weekday today marker
  [[ -f "$CONFIG" ]] || return 1
  [[ "$(jq -r '.enabled // false' "$CONFIG")" == "true" ]] || return 1
  frequency="$(jq -r '.frequency // "daily"' "$CONFIG")"
  hour="$(jq -r '.hour // 2' "$CONFIG")"
  minute="$(jq -r '.minute // 0' "$CONFIG")"
  weekday="$(jq -r '.weekday // 0' "$CONFIG")"
  now_hour="$(date +%-H)"
  now_minute="$(date +%-M)"
  now_weekday="$(date +%w)"
  today="$(date +%F)"
  marker="$today-$hour-$minute"
  [[ "$now_hour" == "$hour" && "$now_minute" == "$minute" ]] || return 1
  [[ "$frequency" != "weekly" || "$now_weekday" == "$weekday" ]] || return 1
  [[ ! -f "$STATE" || "$(cat "$STATE")" != "$marker" ]] || return 1
  printf '%s' "$marker" >"$STATE"
}

prune_backups() {
  local keep
  keep="$(jq -r '.retention // 7' "$CONFIG" 2>/dev/null || echo 7)"
  mapfile -t archives < <(
    find "$BACKUP_ROOT" -maxdepth 1 -type f -name 'overleaf-backup-*.tar.gz.gpg' \
      -printf '%T@ %p\n' | sort -rn | awk '{print $2}'
  )
  for ((i = keep; i < ${#archives[@]}; i++)); do
    rm -f -- "${archives[$i]}" "${archives[$i]}.sha256"
  done
}

run_backup() {
  local output status heartbeat_pid
  jq -n \
    --arg status "running" \
    --arg startedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg message "Creating encrypted backup. Large installations can take several minutes." \
    '{status: $status, startedAt: $startedAt, message: $message}' \
    | write_shared_json "$STATUS"
  (
    while true; do
      write_heartbeat
      sleep 15
    done
  ) &
  heartbeat_pid="$!"
  : >"$RUN_LOG"
  chown "root:$WEB_GID" "$RUN_LOG"
  chmod 640 "$RUN_LOG"
  if /usr/local/bin/overleaf-backup create >"$RUN_LOG" 2>&1; then
    status="success"
  else
    status="failed"
  fi
  kill "$heartbeat_pid" 2>/dev/null || true
  wait "$heartbeat_pid" 2>/dev/null || true
  output="$(tail -c 32768 "$RUN_LOG")"
  jq -n \
    --arg status "$status" \
    --arg finishedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg message "$output" \
    '{status: $status, finishedAt: $finishedAt, message: $message}' \
    | write_shared_json "$STATUS"
  [[ "$status" == "success" ]]
}

while true; do
  write_heartbeat
  if compgen -G "$REQUESTS/create-*" >/dev/null; then
    rm -f -- "$REQUESTS"/create-*
    run_backup || true
    prune_backups
  elif due_now; then
    run_backup || true
    prune_backups
  fi
  sleep 5
done
